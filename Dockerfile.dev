FROM node:22.23.1-slim

WORKDIR /app

RUN npm i -g @nestjs/cli

# COPY package.json ./
# COPY package-lock.json ./
COPY package*.json ./

# usar npm install cuando no exista el archivo package-lock.json
# RUN npm install

# si existe package-lock.json
RUN npm ci

COPY . .

EXPOSE 3000

# RUN npm run start:dev
# levanta el servidor en modo desarrollo, con hot reload
CMD ["npm", "run", "start:dev"]